<?xml version="1.0" encoding="UTF-8"?>
<rendertheme xmlns="http://mapsforge.org/renderTheme" version="5" map-background="#081220" map-background-outside="#080e13">
 <rule e="way" k="*" v="*" closed="yes"><area fill="#102332"/></rule>
 <rule e="way" k="landuse" v="forest|grass|meadow|recreation_ground|village_green"><area fill="#102432"/></rule>
 <rule e="way" k="natural" v="wood|scrub|grassland"><area fill="#122a36"/></rule>
 <rule e="way" k="leisure" v="park|garden|pitch"><area fill="#18333f"/></rule>
 <rule e="way" k="natural" v="water"><area fill="#153b52"/></rule>
 <rule e="way" k="waterway" v="*"><line stroke="#245570" stroke-width="1.5"/><pathText k="name" font-size="12" fill="#77b9df" stroke="#10171c" stroke-width="2"/></rule>
 <rule e="way" k="building" v="*" zoom-min="14"><area fill="#1b3545" stroke="#4a565e" stroke-width="0.5"/></rule>
 <rule e="way" k="railway" v="rail|light_rail"><line stroke="#4d5962" stroke-width="2"/><line stroke="#11191f" stroke-width="1" stroke-dasharray="6,4"/></rule>
 <rule e="way" k="highway" v="*"><line stroke="#080d12" stroke-width="6"/><line stroke="#4e8fa6" stroke-width="3.5"/>
  <rule e="way" k="highway" v="motorway|motorway_link|trunk|trunk_link|primary|primary_link|secondary|secondary_link"><line stroke="#7dd3ec" stroke-width="5"/></rule>
  <rule e="way" k="highway" v="footway|path|steps|cycleway|track"><line stroke="#89969e" stroke-width="1" stroke-dasharray="3,3"/></rule>
  <rule e="way" k="*" v="*" zoom-min="14"><pathText k="name" font-family="sans_serif" font-style="bold" font-size="15" fill="#f4f6f7" stroke="#0a1015" stroke-width="2.5"/></rule>
 </rule>
 <rule e="node" k="place" v="city|town|village|suburb|neighbourhood"><caption k="name" font-size="15" font-style="bold" fill="#e3ebef" stroke="#10171c" stroke-width="2"/></rule>
</rendertheme>